{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "two-spoons",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },

  // The KV namespace this relay stores its two blobs in. A namespace id is not a
  // secret — reaching the data still needs the account, or this Worker.
  "kv_namespaces": [
    {
      "binding": "SYNC",
      "id": "73b9f9372fa44792a38836f33dffbf38"
    }
  ]
}
