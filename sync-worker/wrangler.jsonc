{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "two-spoons-sync",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },

  // Deploying with the "Deploy to Cloudflare" button creates this namespace for you
  // and rewrites the id below. Deploying by hand? Create a KV namespace, then paste
  // its id here (or add the binding in the dashboard under Settings -> Bindings).
  "kv_namespaces": [
    {
      "binding": "SYNC",
      "id": "REPLACED_ON_DEPLOY"
    }
  ]
}
